<!-- pages/add-record/add-record.wxml - 记一笔 -->
<view class="container">

  <!-- 收支类型切换 -->
  <view class="type-switch card flex">
    <view
      class="type-tab flex-center {{type === 'expense' ? 'active expense' : ''}}"
      data-type="expense"
      bindtap="onTypeChange"
    >支出</view>
    <view
      class="type-tab flex-center {{type === 'income' ? 'active income' : ''}}"
      data-type="income"
      bindtap="onTypeChange"
    >收入</view>
  </view>

  <!-- 金额输入 -->
  <view class="card amount-card">
    <view class="amount-row flex">
      <text class="currency">¥</text>
      <input
        class="amount-input"
        type="digit"
        placeholder="0.00"
        value="{{amount}}"
        bindinput="onAmountInput"
        focus="{{true}}"
      />
    </view>
  </view>

  <!-- 分类选择 -->
  <view class="card category-card">
    <view class="section-title">选择分类</view>
    <view class="category-grid">
      <view
        wx:for="{{categories}}"
        wx:key="_id"
        wx:if="{{item.type === type}}"
        class="category-item flex-center {{categoryIndex === index ? 'selected' : ''}}"
        data-index="{{index}}"
        bindtap="onCategorySelect"
      >
        <text class="category-icon">{{item.icon}}</text>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 日期选择 -->
  <view class="card date-card flex-between">
    <text class="section-title">日期</text>
    <picker mode="date" value="{{recordDate}}" bindchange="onDateChange">
      <text class="date-value">{{recordDate}}</text>
    </picker>
  </view>

  <!-- 备注 -->
  <view class="card note-card">
    <input
      class="note-input"
      placeholder="添加备注（选填）"
      value="{{note}}"
      bindinput="onNoteInput"
      maxlength="50"
    />
  </view>

  <!-- 提交按钮 -->
  <view class="submit-area">
    <button
      class="submit-btn flex-center"
      type="primary"
      bindtap="onSubmit"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >记一笔</button>
  </view>

</view>
