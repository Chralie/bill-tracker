/* pages/add-record/add-record.wxss */

.container {
  padding-bottom: 40rpx;
}

/* 类型切换 */
.type-switch {
  padding: 12rpx;
  gap: 12rpx;
}

.type-tab {
  flex: 1;
  height: 72rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  transition: all 0.2s;
}

.type-tab.active {
  color: #fff;
  font-weight: 500;
}

.type-tab.active.expense {
  background-color: #e74c3c;
}

.type-tab.active.income {
  background-color: #07c160;
}

/* 金额输入 */
.amount-card {
  padding: 40rpx 24rpx;
}

.amount-row {
  align-items: baseline;
  border-bottom: 2rpx solid #07c160;
  padding-bottom: 16rpx;
}

.currency {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  margin-right: 8rpx;
}

.amount-input {
  flex: 1;
  font-size: 56rpx;
  font-weight: 600;
  height: 80rpx;
}

/* 分类选择 */
.section-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  flex-direction: column;
  width: calc((100% - 48rpx) / 4);
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  gap: 8rpx;
  transition: all 0.15s;
}

.category-item.selected {
  background-color: #e6f9f0;
  border: 2rpx solid #07c160;
}

.category-icon {
  font-size: 40rpx;
}

.category-name {
  font-size: 22rpx;
  color: #666;
}

/* 日期 & 备注 */
.date-card,
.note-card {
  margin-top: 20rpx;
}

.date-value {
  color: #07c160;
}

.note-input {
  width: 100%;
  font-size: 28rpx;
}

/* 提交按钮 */
.submit-area {
  padding: 40rpx 20rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  background-color: #07c160;
  color: #fff;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: #ffffff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  color: #999999;
  font-size: 22rpx;
  gap: 4rpx;
}

.nav-item.active {
  color: #07c160;
}

.nav-icon {
  font-size: 36rpx;
}

.nav-text {
  font-size: 20rpx;
}
