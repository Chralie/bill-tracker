/* pages/index/index.wxss */

.container {
  padding-bottom: 40rpx;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #ffffff;
  padding: 32rpx;
}

.stats-card .stats-month {
  font-size: 28rpx;
  opacity: 0.8;
  margin-bottom: 16rpx;
}

.stats-body {
  margin-top: 16rpx;
}

.stats-item {
  text-align: center;
}

.stats-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.stats-amount {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

/* 账单列表 */
.record-list {
  margin-top: 20rpx;
}

.record-item-wrapper {
  position: relative;
  overflow: hidden;
  margin-bottom: 2rpx;
}

/* 操作按钮组 - 藏在记录后方 */
.record-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
}

.record-action {
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
}

.record-action.edit {
  background-color: #ffa940;
}

.record-action.delete {
  background-color: #e74c3c;
}

/* 记录内容 - 覆盖在操作按钮上方（margin 必须为 0，否则按钮会从间隙露出） */
.record-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  background-color: #ffffff;
  border-radius: 0;
  margin: 0;
}

.record-left {
  flex-direction: column;
  gap: 8rpx;
}

.record-category {
  font-size: 30rpx;
  font-weight: 500;
}

.record-note {
  font-size: 24rpx;
}

.record-right {
  text-align: right;
}

.record-amount {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.record-date {
  display: block;
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* 空状态 */
.empty-state {
  height: 400rpx;
  white-space: pre-line;
  text-align: center;
  line-height: 1.8;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: #ffffff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  color: #999999;
  font-size: 22rpx;
  gap: 4rpx;
}

.nav-item.active {
  color: #07c160;
}

.nav-icon {
  font-size: 36rpx;
}

.nav-text {
  font-size: 20rpx;
}
