/* 容器 */
.container {
  padding-bottom: 40rpx;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}
.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}

/* ===== 错误状态 ===== */
.error-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}
.error-icon {
  font-size: 80rpx;
}
.error-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* ===== 周期类型切换 ===== */
.period-type-tabs {
  display: flex;
  margin: 20rpx 20rpx 0;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 6rpx;
}
.type-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 10rpx;
  transition: all 0.2s;
}
.type-tab.active {
  background: #fff;
  color: #07c160;
  font-weight: 500;
}

/* ===== 周期选择器 ===== */
.period-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 20rpx 0;
}
.period-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #07c160;
  border-radius: 50%;
  background: #fff;
}
.period-arrow.disabled {
  color: #ccc;
}
.period-label {
  margin: 0 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.date-range-text {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 300rpx;
}
.empty-icon {
  font-size: 80rpx;
}
.empty-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}

/* ===== 汇总卡片 ===== */
.summary-card {
  margin: 20rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #07c160, #06ad56);
  border-radius: 12rpx;
  color: #fff;
}
.summary-row {
  display: flex;
}
.summary-row-secondary {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
}
.summary-item {
  flex: 1;
  text-align: center;
}
.summary-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}
.summary-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

/* ===== 分区 ===== */
.section {
  margin: 20rpx 0 0;
}
.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin: 0 20rpx 16rpx;
}
.empty-section {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* ===== 分类分布行 ===== */
.category-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.category-row + .category-row {
  border-top: 1rpx solid #f5f5f5;
}
.category-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.category-name {
  width: 100rpx;
  font-size: 26rpx;
  color: #333;
  flex-shrink: 0;
}
.bar-track {
  flex: 1;
  height: 24rpx;
  background: #f5f5f5;
  border-radius: 4rpx;
  margin: 0 16rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  min-width: 4rpx;
  transition: width 0.4s ease;
}
.category-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}
.category-amount {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
.category-percent {
  font-size: 22rpx;
  color: #999;
  margin-top: 2rpx;
}

/* ===== 环形图 ===== */
.ring-wrapper {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  margin: 0 auto 24rpx;
}
.ring-chart {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.ring-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ring-total-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}
.ring-total-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.ring-empty {
  width: 320rpx;
  height: 320rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 环形图例 */
.ring-legend {
  margin-top: 8rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}
.legend-item + .legend-item {
  border-top: 1rpx solid #f5f5f5;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.legend-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}
.legend-amount {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-right: 16rpx;
}
.legend-percent {
  font-size: 22rpx;
  color: #999;
  width: 60rpx;
  text-align: right;
}

/* ===== 柱状图 ===== */
.bar-chart-scroll {
  width: 100%;
}
.bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 360rpx;
  padding: 20rpx 0 0;
}
.bar-chart-year {
  min-width: 960rpx;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}
.bar-col-fill {
  width: 36rpx;
  border-radius: 6rpx 6rpx 0 0;
  min-height: 4rpx;
  transition: height 0.4s ease;
}
.bar-col-value {
  font-size: 18rpx;
  color: #666;
  margin-top: 6rpx;
  white-space: nowrap;
}
.bar-col-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

/* ===== 月视图每日列表 ===== */
.daily-list.month {
  max-height: 560rpx;
}
.daily-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.daily-row + .daily-row {
  border-top: 1rpx solid #f5f5f5;
}
.daily-date {
  width: 60rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
  flex-shrink: 0;
}
.daily-bar-track {
  margin: 0 12rpx;
}
.daily-amount {
  width: 130rpx;
  font-size: 24rpx;
  color: #333;
  text-align: right;
  flex-shrink: 0;
}

/* ===== 上限提示 ===== */
.limit-note {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  padding: 20rpx 0;
}

/* ===== 进度条颜色 ===== */
.bar-color-0 { background: #07c160; }
.bar-color-1 { background: #ffa940; }
.bar-color-2 { background: #597ef7; }
.bar-color-3 { background: #e74c3c; }
.bar-color-4 { background: #36cfc9; }
.bar-color-5 { background: #9254de; }
.bar-color-6 { background: #f759ab; }
.bar-color-7 { background: #ffc53d; }

/* ===== 底部导航栏 ===== */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: #ffffff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99;
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  color: #999999;
  font-size: 22rpx;
  gap: 4rpx;
}
.nav-item.active {
  color: #07c160;
}
.nav-icon {
  font-size: 36rpx;
}
.nav-text {
  font-size: 20rpx;
}
